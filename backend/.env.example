# HTTP sunucusu
PORT=5001

# Docker kullanmadan yerel MongoDB Community kurulumu için örnek bağlantı
MONGODB_URI=mongodb://127.0.0.1:27017/gazete-dagitim

# Yerel geliştirme ve elle API testi sırasında zamanlanmış işleri kapatır.
# Otomatik dağıtım/ödeme işleri kullanılacaksa false yapın veya satırı kaldırın.
DISABLE_CRON=true

# MongoDB Atlas SRV sorguları sistem DNS'inde çalışmıyorsa virgülle ayrılmış
# DNS sunucuları verilebilir. Normal koşullarda boş bırakın.
DNS_SERVERS=
