@model GazeteDagitim.Web.Models.ViewModels.CashHandoverPageViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Günlük Kasa Teslimi";
    ViewData["ParentMenu"] = "/menu";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var monthStart = new DateOnly(Model.Date.Year, Model.Date.Month, 1);
    var monthEnd = monthStart.AddMonths(1).AddDays(-1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
}

<main id="main-content" class="page-shell cash-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">KASA YÖNETİMİ</p>
            <h1>Günlük Kasa Teslimi</h1>
            <p>Abone tahsilatlarını, nakit gazete satışlarını ve manuel kasa kalemlerini günlük teslim edin.</p>
        </div>
        <form method="get" class="date-control">
            <label for="date">Kasa tarihi</label>
            <input id="date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
            <button class="button button-secondary" type="submit">Tarihe git</button>
        </form>
    </header>

    @if (TempData["Notice"] is string notice)
    {
        <div class="feedback success" role="status">@notice</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="feedback error" role="alert">@error</div>
    }
    <div asp-validation-summary="All" class="feedback error" role="alert"></div>

    <section class="monthly-total-card">
        <div class="monthly-total-icon">₺</div>
        <div>
            <p>@Model.Date.ToString("MMMM yyyy", tr) kasa özeti</p>
            <h2>Ay içinde teslim edilen toplam</h2>
            <span>@monthStart.ToString("d MMMM", tr) – @monthEnd.ToString("d MMMM yyyy", tr)</span>
        </div>
        <div class="monthly-total-value">
            <strong>@Model.MonthlyDeliveredTotal.ToString("C2", tr)</strong>
            <span>@Model.MonthlyDeliveredDayCount teslim edilmiş gün</span>
        </div>
    </section>

    <section class="panel cash-editor">
        <div class="panel-heading">
            <div>
                <div class="title-with-status">
                    <h2>@Model.Date.ToString("d MMMM yyyy", tr) tahsilatları</h2>
                    <span class="status-tag @(Model.IsDelivered ? "success" : "pending")">@Model.Status</span>
                </div>
                <p>Dağıtımlar menüsündeki nakit tahsilatlar ve gazete satışları otomatik gelir; diğer tutarları manuel ekleyebilirsiniz.</p>
            </div>
            @if (Model.DeliveredAt.HasValue)
            {
                <span class="delivered-time">Teslim: @Model.DeliveredAt.Value.LocalDateTime.ToString("g", tr)</span>
            }
        </div>

        @if (Model.IsDelivered)
        {
            <div class="feedback warning">Bu güne ait kasa teslim edildiği için kayıt değişikliğe kapalıdır.</div>
        }

        @if (Model.AutomaticItems.Count > 0)
        {
            <div class="automatic-cash-summary">
                <span><strong>Otomatik nakit tahsilatları</strong><small>@Model.AutomaticItems.Count tahsilat</small></span>
                <strong>@Model.AutomaticTotal.ToString("C2", tr)</strong>
            </div>
        }

        @if (!Model.IsDelivered)
        {
        <form asp-action="Save" method="post" id="cash-form">
            <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Status" id="cash-status-input" value="Taslak" />
            <datalist id="subscriber-suggestions">
                @foreach (var name in Model.SubscriberSuggestions)
                {
                    <option value="@name"></option>
                }
            </datalist>

            <div class="responsive-table">
                <table class="data-table cash-table">
                    <thead><tr><th>Abone / kaynak</th><th>Tahsil edilen tutar</th><th>Açıklama</th><th>İşlem</th></tr></thead>
                    <tbody id="cash-items">
                    @foreach (var item in Model.AutomaticItems)
                    {
                        <tr class="automatic-row">
                            <td data-label="Kaynak"><strong>@item.SubscriberName</strong><small>Otomatik tahsilat</small></td>
                            <td data-label="Tutar" data-auto-amount="@item.Amount.ToString(CultureInfo.InvariantCulture)"><strong>@item.Amount.ToString("C2", tr)</strong></td>
                            <td data-label="Açıklama">@item.Description</td>
                            <td data-label="İşlem"><span class="status-tag success">@item.PaymentMethod · Otomatik</span></td>
                        </tr>
                    }
                    @for (var index = 0; index < Model.ManualItems.Count; index++)
                    {
                        var item = Model.ManualItems[index];
                        <tr class="manual-cash-row" data-cash-row>
                            <td data-label="Abone">
                                <input type="text"
                                       name="Items[@index].SubscriberName"
                                       value="@item.SubscriberName"
                                       list="subscriber-suggestions"
                                       maxlength="200"
                                       required
                                       disabled="@Model.IsDelivered"
                                       placeholder="Abone adı" />
                            </td>
                            <td data-label="Tutar">
                                <div class="currency-input">
                                    <span>₺</span>
                                    <input type="number"
                                           name="Items[@index].Amount"
                                           value="@item.Amount.ToString("0.00", CultureInfo.InvariantCulture)"
                                           min="0"
                                           step="0.01"
                                           required
                                           disabled="@Model.IsDelivered"
                                           data-cash-amount />
                                </div>
                            </td>
                            <td data-label="Açıklama">
                                <input type="text"
                                       name="Items[@index].Description"
                                       value="@item.Description"
                                       maxlength="1000"
                                       disabled="@Model.IsDelivered"
                                       placeholder="İsteğe bağlı not" />
                            </td>
                            <td data-label="İşlem">
                                <button class="button button-small button-danger" type="button" data-remove-cash-row disabled="@Model.IsDelivered">Sil</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="4"><span>Günlük toplam</span><output id="cash-daily-total">@Model.DailyTotal.ToString("C2", tr)</output></td></tr>
                    </tfoot>
                </table>
            </div>

            <div class="cash-actions">
                <button class="button button-secondary" type="button" id="add-cash-row">+ Tahsilat satırı ekle</button>
                <div>
                    <button class="button button-secondary" type="submit" data-cash-submit="Taslak">Taslak Kaydet</button>
                    <button class="button button-primary" type="submit" data-cash-submit="Teslim Edildi" data-confirm="Günlük kasa teslim edilsin mi? Bu işlem dağıtım kayıtlarını kilitler.">Kasayı Teslim Et</button>
                </div>
            </div>
        </form>
        }
        else
        {
            <div class="responsive-table" aria-label="Teslim edilmiş kasa kalemleri">
                <table class="data-table cash-table">
                    <thead><tr><th>Abone / kaynak</th><th>Tahsil edilen tutar</th><th>Açıklama</th><th>Kaynak</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.AutomaticItems)
                    {
                        <tr class="automatic-row">
                            <td data-label="Abone"><strong>@item.SubscriberName</strong></td>
                            <td data-label="Tutar"><strong>@item.Amount.ToString("C2", tr)</strong></td>
                            <td data-label="Açıklama">@item.Description</td>
                            <td data-label="Kaynak"><span class="status-tag success">@item.PaymentMethod · Otomatik</span></td>
                        </tr>
                    }
                    @foreach (var item in Model.ManualItems)
                    {
                        <tr>
                            <td data-label="Abone"><strong>@item.SubscriberName</strong></td>
                            <td data-label="Tutar"><strong>@item.Amount.ToString("C2", tr)</strong></td>
                            <td data-label="Açıklama">@item.Description</td>
                            <td data-label="Kaynak"><span class="status-tag">Manuel</span></td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="4"><span>Günlük toplam</span><output>@Model.DailyTotal.ToString("C2", tr)</output></td></tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>
</main>

@if (!Model.IsDelivered)
{
<template id="cash-row-template">
    <tr class="manual-cash-row" data-cash-row>
        <td data-label="Abone"><input type="text" data-name="SubscriberName" list="subscriber-suggestions" maxlength="200" required placeholder="Abone adı" /></td>
        <td data-label="Tutar"><div class="currency-input"><span>₺</span><input type="number" data-name="Amount" min="0" step="0.01" required data-cash-amount /></div></td>
        <td data-label="Açıklama"><input type="text" data-name="Description" maxlength="1000" placeholder="İsteğe bağlı not" /></td>
        <td data-label="İşlem"><button class="button button-small button-danger" type="button" data-remove-cash-row>Sil</button></td>
    </tr>
</template>
}

@section Scripts {
    <script src="~/js/cash-handover.js" asp-append-version="true"></script>
}
