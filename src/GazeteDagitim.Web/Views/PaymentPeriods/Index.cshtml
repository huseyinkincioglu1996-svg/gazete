@model GazeteDagitim.Web.Models.ViewModels.PaymentPeriods.PaymentPeriodIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Ödeme Periyotları";
    ViewData["ParentMenu"] = "/menu";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />

<main id="main-content" class="management-page">
    <header class="management-heading">
        <div>
            <span class="management-eyebrow">AYARLAR</span>
            <h1>Ödeme periyotları</h1>
            <p>Abone kayıtlarında kullanılacak tahsilat zamanı, kapsamı ve tutarını yönetin.</p>
        </div>
        <a class="management-button management-button-primary" asp-action="Create">Yeni periyot</a>
    </header>

    @if (TempData["Notice"] is string notice)
    {
        <div class="management-feedback success" role="status">@notice</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="management-feedback error" role="alert">@error</div>
    }

    <nav class="management-filters" aria-label="Ödeme periyodu durum filtresi">
        <a class="@(Model.Status == "all" ? "active" : null)" asp-action="Index" asp-route-status="all">
            Tümü
        </a>
        <a class="@(Model.Status == "active" ? "active" : null)" asp-action="Index" asp-route-status="active">
            Aktif
        </a>
        <a class="@(Model.Status == "inactive" ? "active" : null)" asp-action="Index" asp-route-status="inactive">
            Pasif
        </a>
    </nav>

    @if (Model.Items.Count == 0)
    {
        <div class="payment-period-empty">Bu filtreye uygun ödeme periyodu bulunamadı.</div>
    }
    else
    {
        <section class="payment-period-list" aria-label="Ödeme periyotları">
            @foreach (var item in Model.Items)
            {
                var collectionTiming = item.CollectionDayOfMonth.HasValue && item.CollectionTime.HasValue
                    ? item.IsDaily
                        ? "Her gün"
                        : item.IsWeekly
                            ? "Başlangıçtan itibaren her 7 gün"
                            : item.DayCount == 10
                                ? "Ayın 10., 20. ve son günü"
                                : $"Ayın {item.CollectionDayOfMonth}. günü"
                    : "Belirlenmedi";
                var collectionTime = item.CollectionTime?.ToString("HH:mm") ?? string.Empty;
                var coverage = item.IsDaily
                    ? "Her ödeme 1 gün"
                    : item.IsWeekly
                        ? "Her ödeme 7 gün"
                        : $"{item.DayCount} gün";
                var amount = item.CollectionAmount.HasValue
                    ? item.CollectionAmount.Value.ToString("C2", tr)
                    : "Belirlenmedi";

                <details class="payment-period-row @(!item.IsActive ? "is-passive" : null)">
                    <summary class="payment-period-summary"
                             aria-label="@item.Name ayrıntılarını aç veya kapat">
                        <span class="payment-period-summary-name">
                            <strong>@item.Name</strong>
                            <small>@coverage</small>
                        </span>
                        <span class="payment-period-summary-meta payment-period-summary-time">
                            <small>Tahsilat zamanı</small>
                            <strong>@collectionTiming</strong>
                        </span>
                        <span class="payment-period-summary-meta payment-period-summary-amount">
                            <small>Tutar</small>
                            <strong>@amount</strong>
                        </span>
                        <span class="management-status @(item.IsActive ? "active" : "passive")">
                            @(item.IsActive ? "Aktif" : "Pasif")
                        </span>
                        <span class="payment-period-chevron" aria-hidden="true"></span>
                    </summary>

                    <div class="payment-period-details">
                        <dl class="payment-period-definition-grid">
                            <div>
                                <dt>Tahsilat zamanı</dt>
                                <dd>
                                    <strong>@collectionTiming</strong>
                                    @if (!string.IsNullOrWhiteSpace(collectionTime))
                                    {
                                        <small>@collectionTime</small>
                                    }
                                </dd>
                            </div>
                            <div>
                                <dt>Ödeme kapsamı</dt>
                                <dd>@coverage</dd>
                            </div>
                            <div>
                                <dt>Tutar</dt>
                                <dd>@amount</dd>
                            </div>
                            <div>
                                <dt>Açıklama</dt>
                                <dd>@(string.IsNullOrWhiteSpace(item.Description) ? "Açıklama yok" : item.Description)</dd>
                            </div>
                        </dl>

                        <div class="management-row-actions payment-period-actions">
                            <a class="management-button management-button-secondary"
                               asp-action="Edit"
                               asp-route-id="@item.Id">
                                Düzenle
                            </a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                <input type="hidden" name="status" value="@Model.Status" />
                                <button class="management-button @(item.IsActive ? "management-button-danger" : "management-button-primary")"
                                        type="submit">
                                    @(item.IsActive ? "Pasife al" : "Aktifleştir")
                                </button>
                            </form>
                        </div>
                    </div>
                </details>
            }
        </section>
    }
</main>
