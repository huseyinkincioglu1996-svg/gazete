<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050506" />
    <meta name="description" content="Gazete Dağıtım ve Ödeme Takip Sistemi" />
    <meta name="application-name" content="Gazete Dağıtım" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Gazete" />
    <title>@ViewData["Title"] - Gazete Dağıtım</title>
    <script type="importmap"></script>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GazeteDagitim.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var parentMenu = ViewData["ParentMenu"] as string;
}
<body class="@bodyClass"
      data-swipe-back-target="@parentMenu">
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>

    @RenderBody()

    <div class="network-status-banner"
         data-offline-banner
         role="alert"
         aria-live="assertive"
         hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 3l18 18M8.7 5.5A15.3 15.3 0 0 1 21 9m-18 0a15.2 15.2 0 0 1 2.7-1.6M6.5 12.5a9.1 9.1 0 0 1 8.8-1.8M9.5 16a4.2 4.2 0 0 1 3.5-.9M12 20h.01"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"></path>
        </svg>
        <span>
            <strong>İnternet bağlantısı yok</strong>
            Kayıt işlemleri bağlantı gelene kadar kullanılamaz.
        </span>
    </div>

    <aside class="pwa-action-panel"
           data-pwa-panel
           aria-live="polite"
           hidden>
        <div class="pwa-action-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
                <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 15v4h14v-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.2"></path>
            </svg>
        </div>
        <div class="pwa-action-content">
            <strong data-pwa-title>Gazete Dağıtım uygulamasını yükle</strong>
            <span data-pwa-copy>Uygulamayı ana ekrandan hızlıca açabilirsiniz.</span>
        </div>
        <div class="pwa-action-buttons">
            <button class="pwa-action-primary"
                    type="button"
                    data-pwa-primary>
                Uygulamayı yükle
            </button>
            <button class="pwa-action-dismiss"
                    type="button"
                    data-pwa-dismiss
                    aria-label="Kurulum bildirimini kapat">
                &times;
            </button>
        </div>
    </aside>

    @if (!string.IsNullOrWhiteSpace(parentMenu))
    {
        <div class="edge-swipe-indicator"
             data-edge-swipe-indicator
             aria-hidden="true">
            <svg class="edge-swipe-icon"
                 viewBox="0 0 36 36"
                 aria-hidden="true"
                 focusable="false">
                <path d="M15.5 2 2.5 11l13 9.5v-6h2.8"
                      fill="currentColor"
                      stroke="currentColor"
                      stroke-linejoin="round"
                      stroke-width="1.5"></path>
                <path d="M16.5 11.5h2.2a11.8 11.8 0 1 1-11.4 14.9"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-width="5.4"></path>
            </svg>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
