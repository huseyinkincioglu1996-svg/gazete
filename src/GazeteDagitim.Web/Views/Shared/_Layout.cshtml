<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050506" />
    <meta name="description" content="Gazete Dağıtım ve Ödeme Takip Sistemi" />
    <title>@ViewData["Title"] - Gazete Dağıtım</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GazeteDagitim.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var parentMenu = ViewData["ParentMenu"] as string;
}
<body class="@bodyClass"
      data-swipe-back-target="@parentMenu">
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>

    @RenderBody()

    @if (!string.IsNullOrWhiteSpace(parentMenu))
    {
        <div class="edge-swipe-indicator"
             data-edge-swipe-indicator
             aria-hidden="true">
            <svg class="edge-swipe-icon"
                 viewBox="0 0 36 36"
                 aria-hidden="true"
                 focusable="false">
                <path d="M15.5 2 2.5 11l13 9.5v-6h2.8"
                      fill="currentColor"
                      stroke="currentColor"
                      stroke-linejoin="round"
                      stroke-width="1.5"></path>
                <path d="M16.5 11.5h2.2a11.8 11.8 0 1 1-11.4 14.9"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-width="5.4"></path>
            </svg>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
