@model GazeteDagitim.Web.Models.ViewModels.Subscribers.SubscriberIndexViewModel
@{
    ViewData["Title"] = "Aboneler";
    ViewData["ParentMenu"] = "/menu";
}

<link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />

<main id="main-content" class="management-page">
    <header class="management-heading">
        <div>
            <span class="management-eyebrow">ABONE YÖNETİMİ</span>
            <h1>Aboneler</h1>
            <p>Abone bilgilerini, yayın günlerini, ödeme periyodunu ve teslimat konumunu yönetin.</p>
        </div>
        <a class="management-button management-button-primary" asp-action="Create">Yeni abone</a>
    </header>

    @if (TempData["Notice"] is string notice)
    {
        <div class="management-feedback success" role="status">@notice</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="management-feedback error" role="alert">@error</div>
    }

    <nav class="management-filters" aria-label="Abone durum filtresi">
        <a class="@(Model.Status == "all" ? "active" : null)" asp-action="Index" asp-route-status="all">
            Tümü
        </a>
        <a class="@(Model.Status == "active" ? "active" : null)" asp-action="Index" asp-route-status="active">
            Aktif
        </a>
        <a class="@(Model.Status == "inactive" ? "active" : null)" asp-action="Index" asp-route-status="inactive">
            Pasif
        </a>
    </nav>

    <div class="management-table-shell">
        <table class="management-table">
            <thead>
                <tr>
                    <th>Abone</th>
                    <th>Plan</th>
                    <th>Gazete günleri</th>
                    <th>Aylık ücret</th>
                    <th>Durum</th>
                    <th class="management-actions-heading">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td class="management-empty" colspan="6">Bu filtreye uygun abone bulunamadı.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    var paymentDetailsUrl = Url.Action(
                        "Details",
                        "SubscriberPayments",
                        new { subscriberId = item.Id });
                    <tr class="@(!item.IsActive ? "is-passive" : null)"
                        tabindex="0"
                        role="link"
                        aria-label="@item.Name ödeme detaylarını aç"
                        data-row-link="@paymentDetailsUrl">
                        <td data-label="Abone">
                            <a class="management-subscriber-link"
                               href="@paymentDetailsUrl">
                                <strong>@item.Name</strong>
                                <span>Ödeme detaylarını aç</span>
                            </a>
                            @if (!string.IsNullOrWhiteSpace(item.Phone))
                            {
                                <small>@item.Phone</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Address))
                            {
                                <small>@item.Address</small>
                            }
                            @if (item.Latitude.HasValue && item.Longitude.HasValue)
                            {
                                <a class="management-map-link"
                                   href="https://www.google.com/maps?q=@item.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@item.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Google Maps'te aç
                                </a>
                            }
                        </td>
                        <td data-label="Plan">
                            <span>@(item.PaymentPeriodName ?? "Periyot yok")</span>
                            <small>@(item.DistributorName ?? "Dağıtıcı atanmamış")</small>
                        </td>
                        <td data-label="Gazete günleri">
                            <div class="management-chip-list">
                                @if (item.NewspaperDays.Count == 0)
                                {
                                    <span class="management-muted">Gün seçilmemiş</span>
                                }
                                else
                                {
                                    @foreach (var day in item.NewspaperDays)
                                    {
                                        <span class="management-chip">@day</span>
                                    }
                                }
                            </div>
                        </td>
                        <td data-label="Aylık ücret">
                            <strong>@item.MonthlyFee.ToString("N2") ₺</strong>
                        </td>
                        <td data-label="Durum">
                            <span class="management-status @(item.IsActive ? "active" : "passive")">
                                @(item.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td data-label="İşlemler">
                            <div class="management-row-actions">
                                <a class="management-button management-button-secondary"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id">
                                    Düzenle
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                                    <input type="hidden" name="status" value="@Model.Status" />
                                    <button class="management-button @(item.IsActive ? "management-button-danger" : "management-button-primary")"
                                            type="submit">
                                        @(item.IsActive ? "Pasife al" : "Aktifleştir")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</main>

@section Scripts {
    <script src="~/js/management.js" asp-append-version="true"></script>
}
